#!/bin/sh
# Starts SpiderFoot's web interface on this computer only and opens it.
set -u
addr=127.0.0.1:5001
if ! curl -fsS -o /dev/null "http://$addr/" 2>/dev/null; then
	mkdir -p "$HOME/.spiderfoot"
	nohup /usr/local/bin/spiderfoot -l "$addr" >"$HOME/.spiderfoot/web.log" 2>&1 &
	i=0
	until curl -fsS -o /dev/null "http://$addr/" 2>/dev/null; do
		i=$((i + 1))
		if [ "$i" -gt 60 ]; then
			zenity --error --title=SpiderFoot --text="SpiderFoot did not start. Its log is in ~/.spiderfoot/web.log." 2>/dev/null
			exit 1
		fi
		sleep 1
	done
fi
exec xdg-open "http://$addr/"
