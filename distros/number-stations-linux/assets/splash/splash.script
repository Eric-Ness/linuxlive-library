# Number Stations boot splash (Plymouth script theme), made with linuxlive.
# A waterfall scrolls down the whole screen behind the logo and the name; a
# thin bar under the name fills as the computer starts.
#
# The screen can change size partway through the boot (when the graphics
# driver takes over from the firmware's screen), so everything is laid out
# again whenever it does: the waterfall rescaled to cover the new screen, the
# panel, logo, name and bar centred on it.

Window.SetBackgroundTopColor(0.949, 0.965, 0.976);
Window.SetBackgroundBottomColor(0.949, 0.965, 0.976);

# The waterfall: one image that repeats, in three copies stacked so there is
# never a gap while it moves.
strip_source = Image("strip.png");
for (i = 0; i < 3; i++) {
    strips[i] = Sprite();
    strips[i].SetZ(-100);
}

# The centre: a soft panel, the distro's logo (linuxlive puts it in every
# splash as watermark.png), the name, a line and the progress bar.
panel = Sprite(Image("panel.png"));
logo = Sprite(Image("watermark.png").Scale(150, 150));
title = Sprite(Image("title.png"));
sub = Sprite(Image("sub.png"));
bar_bg_image = Image("bar-bg.png");
bar_image = Image("bar.png");
bar_bg = Sprite(bar_bg_image);
bar = Sprite();
message = Sprite();
message.SetZ(30);

sw = 0;
sh = 0;
sh_strip = 1;
offset = 0;
cx = 0;
cy = 0;

fun place_strips() {
    for (i = 0; i < 3; i++)
        strips[i].SetY(offset + (i - 1) * sh_strip);
}

fun layout() {
    sw = Window.GetWidth();
    sh = Window.GetHeight();
    scale = Math.Max(sw / strip_source.GetWidth(), sh / strip_source.GetHeight());
    strip_image = strip_source.Scale(strip_source.GetWidth() * scale, strip_source.GetHeight() * scale);
    sh_strip = strip_image.GetHeight();
    for (i = 0; i < 3; i++) {
        strips[i].SetImage(strip_image);
        strips[i].SetX((sw - strip_image.GetWidth()) / 2);
    }
    if (offset >= sh_strip) offset = 0;
    place_strips();
    cx = sw / 2;
    cy = sh / 2;
    panel.SetPosition(cx - panel.GetImage().GetWidth() / 2, cy - panel.GetImage().GetHeight() / 2, 10);
    logo.SetPosition(cx - logo.GetImage().GetWidth() / 2, cy - 140, 20);
    title.SetPosition(cx - title.GetImage().GetWidth() / 2, cy + 18, 20);
    sub.SetPosition(cx - sub.GetImage().GetWidth() / 2, cy + 86, 20);
    bar_bg.SetPosition(cx - bar_bg_image.GetWidth() / 2, cy + 126, 20);
    bar.SetPosition(cx - bar_bg_image.GetWidth() / 2, cy + 126, 21);
    message.SetY(cy + 190);
}
layout();

# Plymouth calls this about 50 times a second. Moving a full-screen image
# repaints the whole screen, which is heavy where nothing helps draw (a
# virtual machine without 3D, a slow PC) and can hold up the boot itself, so
# the waterfall moves only every fifth time: two rows at a time, about ten
# repaints a second, new rows arriving at the top as in WSJT-X.
ticks = 0;
fun refresh_callback() {
    if (Window.GetWidth() != sw || Window.GetHeight() != sh) layout();
    ticks = ticks + 1;
    if (ticks >= 5) {
        ticks = 0;
        offset = offset + 2;
        if (offset >= sh_strip) offset = 0;
        place_strips();
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
    width = Math.Int(bar_image.GetWidth() * progress);
    if (width > 0)
        bar.SetImage(bar_image.Scale(width, bar_image.GetHeight()));
}
Plymouth.SetBootProgressFunction(progress_callback);

# Messages (for example a disk check) and password prompts, under the panel.
fun message_callback(text) {
    image = Image.Text(text, 0.094, 0.204, 0.275);
    message.SetImage(image);
    message.SetX(cx - image.GetWidth() / 2);
}
Plymouth.SetMessageFunction(message_callback);

fun display_password_callback(prompt, bullets) {
    text = prompt + "  ";
    for (i = 0; i < bullets; i++) text = text + "*";
    message_callback(text);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    message.SetImage(Image.Text("", 0, 0, 0));
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
